rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId) && request.resource.data.userId == userId;
      allow delete: if isOwner(userId);

      match /tasks/{taskId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(taskId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      match /goals/{goalId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(goalId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(goalId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(goalId);
      }

      match /habits/{habitId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(habitId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(habitId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(habitId);
      }

      match /habitRecords/{recordId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(recordId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(recordId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(recordId);
      }

      match /focusSessions/{sessionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(sessionId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(sessionId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(sessionId);
      }

      match /categories/{categoryId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(categoryId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(categoryId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(categoryId);
      }

      match /dailyScores/{date} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(date) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(date);
      }

      match /xpTransactions/{txId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(txId) && request.resource.data.userId == userId;
        allow update: if false; // Transactions are immutable audit logs
        allow delete: if isOwner(userId) && isValidId(txId);
      }

      match /achievements/{achievementId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(achievementId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(achievementId);
      }

      match /weeklyReviews/{reviewId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(reviewId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(reviewId);
      }

      match /projects/{projectId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(projectId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(projectId);
      }

      match /notes/{noteId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(noteId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(noteId);
      }

      match /expenses/{expenseId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(expenseId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(expenseId);
      }

      match /budgets/{budgetId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(budgetId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(budgetId);
      }

      match /reminders/{reminderId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(reminderId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(reminderId);
      }

      match /plans/{planId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(planId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(planId);
      }
    }
  }
}
